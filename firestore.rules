rules_version = '2';
// Curio security rules. Every user-owned path is restricted to its owner; the
// catalogue is read-only for signed-in users and writable only by curators.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function str(v, max) { return v is string && v.size() <= max; }
    function topicOk(t) { return t is string && t.matches('^[a-z0-9-]{2,40}$'); }
    function providerOk(p) { return p in ['youtube', 'instagram']; }
    function urlOk(u) {
      return u is string && u.size() <= 300 &&
        (u.matches('^https://www[.]youtube[.]com/shorts/[A-Za-z0-9_-]{11}$') ||
         u.matches('^https://www[.]instagram[.]com/reel/[A-Za-z0-9_-]{5,40}/$'));
    }
    function thumbOk(u) { return u == '' || (u is string && u.size() <= 500 && u.matches('^https://i[.]ytimg[.]com/.*')); }

    // Curators: managed in the Firebase console only. A user may check their own flag.
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    // Catalogue
    match /videos/{id} {
      allow get, list: if signedIn() && (resource.data.status == 'approved' || isAdmin());
      allow create, update: if isAdmin() && validVideo(request.resource.data) &&
        id == request.resource.data.provider + '_' + request.resource.data.providerVideoId;
      allow delete: if isAdmin();
    }
    function validVideo(d) {
      return d.keys().hasOnly(['provider','providerVideoId','canonicalUrl','title','creatorName','thumbnailUrl','topic','tags','status','embedAllowed','rand','source','createdAt','checkedAt']) &&
        providerOk(d.provider) && str(d.providerVideoId, 40) && urlOk(d.canonicalUrl) &&
        str(d.title, 200) && str(d.creatorName, 100) && thumbOk(d.thumbnailUrl) && topicOk(d.topic) &&
        d.tags is list && d.tags.size() <= 10 &&
        d.status in ['approved', 'pending', 'unavailable', 'disabled'] &&
        d.embedAllowed is bool && d.rand is number && d.rand >= 0 && d.rand < 1 &&
        d.source in ['admin', 'submission', 'ingest'];
    }

    // Profiles (minimal). lastSubmitAt powers the submission cooldown below.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'createdAt']) &&
        str(request.resource.data.displayName, 100) && str(request.resource.data.photoURL, 500) &&
        request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSubmitAt', 'displayName', 'photoURL']) &&
        (!('lastSubmitAt' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastSubmitAt == request.time) &&
        str(request.resource.data.displayName, 100) && str(request.resource.data.photoURL, 500);
      allow delete: if isOwner(uid);

      // Watched history: private, owner-only. Doc id = video id (dedupe).
      match /history/{videoId} {
        allow get, list, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['provider','providerVideoId','canonicalUrl','title','creatorName','thumbnailUrl','topic','watchSeconds','watchedAt']) &&
          providerOk(request.resource.data.provider) &&
          videoId == request.resource.data.provider + '_' + request.resource.data.providerVideoId &&
          urlOk(request.resource.data.canonicalUrl) &&
          str(request.resource.data.title, 200) && str(request.resource.data.creatorName, 100) &&
          thumbOk(request.resource.data.thumbnailUrl) && topicOk(request.resource.data.topic) &&
          request.resource.data.watchSeconds is int && request.resource.data.watchSeconds >= 0 && request.resource.data.watchSeconds <= 86400 &&
          request.resource.data.watchedAt == request.time &&
          // Rate limit: at most one write per video every 10 seconds.
          (resource == null || request.time > resource.data.watchedAt + duration.value(10, 's'));
      }

      // Per-topic watch seconds for the Polymath chart (owner-only, max one write per 10 s).
      match /state/stats {
        allow get, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['topics', 'updatedAt']) &&
          request.resource.data.topics is map && request.resource.data.topics.size() <= 40 &&
          request.resource.data.updatedAt == request.time &&
          (resource == null || request.time > resource.data.updatedAt + duration.value(10, 's'));
      }

      // Feed state: shuffled topic cycle, queued items, recent ids (owner-only, size-bounded).
      match /state/{docId} {
        allow get, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'feed' &&
          request.resource.data.keys().hasOnly(['cycle','pos','exhausted','lastTopics','queue','recent','updatedAt']) &&
          request.resource.data.cycle is list && request.resource.data.cycle.size() <= 60 &&
          request.resource.data.pos is int &&
          request.resource.data.exhausted is list && request.resource.data.exhausted.size() <= 60 &&
          request.resource.data.lastTopics is list && request.resource.data.lastTopics.size() <= 6 &&
          request.resource.data.queue is list && request.resource.data.queue.size() <= 25 &&
          request.resource.data.recent is list && request.resource.data.recent.size() <= 400 &&
          request.resource.data.updatedAt == request.time;
      }
    }

    // Community submissions: pending until a curator reviews. 30s per-user cooldown.
    match /submissions/{id} {
      allow get: if isAdmin() || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['provider','providerVideoId','canonicalUrl','proposedTopic','title','creatorName','submittedBy','reviewStatus','createdAt']) &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.reviewStatus == 'pending' &&
        request.resource.data.createdAt == request.time &&
        providerOk(request.resource.data.provider) && str(request.resource.data.providerVideoId, 40) &&
        urlOk(request.resource.data.canonicalUrl) && topicOk(request.resource.data.proposedTopic) &&
        str(request.resource.data.title, 200) && str(request.resource.data.creatorName, 100) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastSubmitAt == request.time &&
        (!('lastSubmitAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastSubmitAt + duration.value(30, 's'));
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus', 'reviewerId', 'reviewedAt']) &&
        request.resource.data.reviewStatus in ['approved', 'rejected'] &&
        request.resource.data.reviewerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Written only by the ingestion job (Admin SDK bypasses rules).
    match /ingestionRuns/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
